# Caddy is the only thing in the container that binds a public port: it
# serves the frontend's static build and reverse-proxies /api/* to the Go
# backend on 127.0.0.1, so both are reached through the same origin without
# the backend ever serving a file itself.
{
	admin off

	# Which addresses may say who the client really is, in X-Forwarded-For:
	# a reverse proxy in front of this one. Private ranges by default, where
	# such a proxy lives (on the same Docker network, say); a deployment that
	# knows better names them in GAMELOG_TRUSTED_PROXIES. Strict, so that
	# only the address a trusted proxy added is read, never one a client
	# wrote in the header itself.
	servers {
		trusted_proxies static {$GAMELOG_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
}

:9999 {
	encode gzip

	handle /api/* {
		# The client's address as worked out above, which the backend
		# trusts from here alone, for its logs and to count failed logins.
		# Set here whatever the request carried.
		reverse_proxy 127.0.0.1:{$GAMELOG_PORT:8080} {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		# The Alpine image ships no mime.types, so without this the manifest
		# would be served without a content type.
		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json

		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
