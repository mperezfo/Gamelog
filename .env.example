# Copy this file to .env and adjust whatever you need.
# Both Docker Compose and the Go backend read it.

GAMELOG_PORT=8080

# Serve the interactive API documentation at /api/docs. The OpenAPI document
# itself (/api/openapi.json) is always served. The console issues its requests
# with whatever session the browser holds, so it grants nothing a signed-in
# user does not already have; set this to false to take the page away anyway.
GAMELOG_DOCS=true

# How long a session lasts without being used. It renews itself while in use,
# so a browser that visits now and then is never signed out.
GAMELOG_SESSION_LIFETIME=8760h

# Mark the session cookie Secure. Leave it off for a deployment reached over
# plain http:// (a Tailscale address, say): a Secure cookie is never sent back
# over http, and nobody would be able to log in at all. Turn it on behind HTTPS.
GAMELOG_SECURE_COOKIE=false

# Creates the admin account at startup, and only on a deployment that has no
# accounts at all. For unattended installs; the normal path is the first-run
# screen, which does not leave a password sitting in a file.
# GAMELOG_ADMIN_PASSWORD=

# Apply pending schema migrations at startup. Set to false to control when the
# schema changes yourself.
GAMELOG_MIGRATE=true

# Where uploaded cover images are stored on disk, content-addressed by the
# sha256 of their bytes.
GAMELOG_IMAGES_DIR=./data/images

# Release reminders through ntfy. Without GAMELOG_NTFY_URL no channel is
# offered and nothing is sent. Set TZ as well, so that "today" and the hour
# below are yours and not UTC.
# GAMELOG_NTFY_URL=https://ntfy.sh
# GAMELOG_NTFY_TOKEN=
# Hour of the day from which the day's reminders go out.
GAMELOG_NOTIFY_HOUR=9

GAMELOG_DB_HOST=127.0.0.1
GAMELOG_DB_PORT=3306
GAMELOG_DB_NAME=gamelog
GAMELOG_DB_USER=gamelog
GAMELOG_DB_PASSWORD=gamelog
GAMELOG_DB_ROOT_PASSWORD=root
